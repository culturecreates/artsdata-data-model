####################################################
# Artsdata CORE Graph SHACL Shapes v2.0
####################################################
#
# Description:
# Validates the Artsdata CORE graph (the reconciled, Artsdata-minted graph
# published at kg.artsdata.ca) for Event, LivePerformanceWork, Organization,
# Place and Person. This is a different graph, with different rules, from
# what shacl/shacl_artsdata.ttl validates (raw data POSTed by external
# providers to the Artsdata Databus, per shacl_reports.md).
#
# One file per class, all sharing the ads: (http://kg.artsdata.ca/shacl/)
# namespace and meant to always be loaded together as a single shapes graph:
#   shacl_artsdata_common.ttl              -- property shapes reused across classes (this file)
#   shacl_artsdata_event.ttl               -- schema:Event / ado:Event
#   shacl_artsdata_liveperformancework.ttl -- ado:LivePerformanceWork
#   shacl_artsdata_organization.ttl        -- schema:Organization
#   shacl_artsdata_place.ttl               -- schema:Place
#   shacl_artsdata_person.ttl              -- schema:Person
# A class file alone is incomplete: it references the shared shapes (name,
# url, description, ...) declared here, and its controlled-vocabulary
# concept checks (e.g. ads:EventTypeConceptShape) live alongside its own
# class shape in that same file. Loading a class file without the others
# silently drops those constraints rather than erroring.
#
# Ground truth: every property shaped here is derived directly from the
# Artsdata mint pipeline in the artsdata-api repo, not from the aspirational
# ontology. That pipeline runs in two stages:
#   1. Initial CONSTRUCT queries, one per class, e.g.
#      artsdata-api/app/services/sparqls/mint/event/construct_event_transform.sparql
#      (and .../liveperformancework/, .../organization/, .../place/, .../person/)
#   2. Subsequent enrichment queries that refine the constructed graph, e.g.
#      artsdata-api/.../mint/transform/K1-209_map_event_types.sparql,
#      K1-210_map_place_types.sparql and K1-212_map_organization_types.sparql,
#      which delete any schema:additionalType value that matches a
#      controlled-vocabulary mapping and insert ado:hasEventTypeConcept /
#      ado:hasPlaceTypeConcept / ado:hasOrganizationTypeConcept pointing at
#      the matching adr: (Artsdata) concept instead. Unmapped additionalType
#      values are left in place, so both properties can coexist on one entity.
#      These queries also insert an RDF-star provenance triple on the
#      new statement (prov:wasGeneratedBy / prov:used) -- that provenance
#      metadata is intentionally NOT validated by these files.
#
# Because the CORE graph is the reconciled graph, every property that
# references another entity or concept (organizer, performer, location,
# hasEventTypeConcept, hasPlaceTypeConcept, hasOrganizationTypeConcept,
# hasGenre, usesExpressionOf, managedBy, ownedBy, usedBy, hasResident) is
# required to be an Artsdata-minted adr: (kg.artsdata.ca) URI. This is
# applied uniformly by design, even though today's mint queries only filter
# for it in some cases (organizer, performer, hasGenre, hasEventTypeConcept,
# hasPlaceTypeConcept, hasOrganizationTypeConcept) and not others (location,
# managedBy, ownedBy, usedBy, hasResident) -- a violation on one of the
# not-yet-filtered properties is a useful signal that the mint query may
# need to catch up, not necessarily a bad shape. Because of this adr:-only
# scope, these files intentionally do not validate generic (non-Artsdata-
# minted) ado: property usage -- that is out of scope for the CORE graph.
#
# ado:usesExpressionOf is included even though no enrichment SPARQL mints it
# yet; its constraints are inferred from the ontology's declared range plus
# the reconciliation convention above, and should be re-checked once that
# query exists.
#
# Controlled-vocabulary concept checks: the *TypeConceptShape /
# GenreConceptShape shapes (one per class file that has a controlled-
# vocabulary property) are declared as self-targeting (sh:targetObjectsOf)
# node shapes, rather than referenced with sh:node from the property shapes
# above. sh:node always reports a plain sh:Violation when the referenced
# shape fails to conform, no matter what severity its internal property
# constraints declare, which would silently turn the "deprecated concept"
# Warning into a hard Violation. Self-targeting keeps each constraint's own
# severity intact, and they apply automatically to the same triples once
# loaded alongside the property shapes above.
#
# Out of scope: ado:originEC appears in the Organization and Person mint
# queries but is not declared anywhere in ontology/artsdata-ontology.ttl.
# Its range/vocabulary is unknown, so it is deliberately left unshaped here
# until it is formalized in the ontology.
####################################################


################
# Shared property/value shapes, reused across classes
################

ads:NameSh
    a sh:PropertyShape ;
    sh:path schema:name ;
    sh:name "name" ;
    sh:minCount 1 ;
    sh:uniqueLang true ;
    sh:or (
        [ sh:datatype rdf:langString ; ]
        [ sh:datatype xsd:string ; ]
    ) ;
    sh:message "schema:name is required (at least one value; multiple values must each have a distinct language tag)."@en .

ads:PrefLabelSh
    a sh:PropertyShape ;
    sh:path skos:prefLabel ;
    sh:name "pref label" ;
    sh:minCount 1 ;
    sh:uniqueLang true ;
    sh:or (
        [ sh:datatype rdf:langString ; ]
        [ sh:datatype xsd:string ; ]
    ) ;
    sh:message "skos:prefLabel is required (at least one value; multiple values must each have a distinct language tag)."@en .

ads:NoSchemaNameOnConceptSh
    a sh:PropertyShape ;
    sh:path schema:name ;
    sh:name "name (forbidden on concepts)" ;
    sh:maxCount 0 ;
    sh:message "skos:Concept entities must be labelled with skos:prefLabel, not schema:name."@en .

ads:UrlSh
    a sh:PropertyShape ;
    sh:path schema:url ;
    sh:name "url" ;
    sh:minCount 0 ;
    sh:nodeKind sh:IRI ;
    sh:message "schema:url must be a valid URL."@en .

ads:SameAsSh
    a sh:PropertyShape ;
    sh:path schema:sameAs ;
    sh:name "sameAs" ;
    sh:minCount 0 ;
    sh:nodeKind sh:IRI ;
    sh:message "schema:sameAs must be a valid URL."@en .

ads:AdditionalTypeSh
    a sh:PropertyShape ;
    sh:path schema:additionalType ;
    sh:name "additional type" ;
    sh:minCount 0 ;
    sh:nodeKind sh:IRI ;
    sh:message "schema:additionalType must be a URI."@en .

ads:DescriptionShape
    a sh:NodeShape ;
    sh:name "Description value (any entity)" ;
    sh:targetObjectsOf schema:description ;
    sh:sparql [
        sh:message "schema:description must not be blank, whitespace-only, or contain only HTML markup with no visible text."@en ;
        sh:select """
            SELECT $this
            WHERE {
                BIND(REPLACE(STR($this), "<[^>]*>", "") AS ?stripped)
                FILTER(REGEX(?stripped, "^\\\\s*$"))
            }
        """ ;
    ] .

ads:AlternateNameSh
    a sh:PropertyShape ;
    sh:path schema:alternateName ;
    sh:name "alternate name" ;
    sh:minCount 0 .

ads:DisambiguatingDescriptionSh
    a sh:PropertyShape ;
    sh:path schema:disambiguatingDescription ;
    sh:name "disambiguating description" ;
    sh:minCount 0 .

# schema:image / schema:logo are copied through the mint pipeline as opaque
# nodes with arbitrary properties (?image_p ?image_o), unlike Event's image
# (see ads:EventImageShape in shacl_artsdata_event.ttl) which has a fixed
# structure -- so this is deliberately left unconstrained beyond "it must be
# present if given".
ads:UnstructuredImageSh
    a sh:PropertyShape ;
    sh:path schema:image ;
    sh:name "image" ;
    sh:minCount 0 .

####################################################
# From shacl_artsdata_event.ttl
####################################################

####################################################
# schema:Event / ado:Event
# See shacl_artsdata_common.ttl for the shared shapes referenced below and
# the file-set header. Must be loaded together with that file (and, for the
# controlled-vocabulary check below, ontology/skos-event-types.ttl).
#
# Source: artsdata-api/app/services/sparqls/mint/event/construct_event_transform.sparql
#         artsdata-api/app/services/sparqls/mint/transform/K1-209_map_event_types.sparql
#
# ado:Event owl:equivalentClass schema:Event, so both are targeted here.
####################################################

ads:EventShape
    a sh:NodeShape ;
    sh:name "Event Shape" ;
    sh:targetClass schema:Event, ado:Event ;
    sh:property ads:NameSh,
                ads:UrlSh,
                ads:AdditionalTypeSh,
                ads:StartDateSh,
                ads:EndDateSh,
                ads:EventDescriptionSh,
                ads:LocationSh,
                ads:EventStatusSh,
                ads:EventAttendanceModeSh,
                ads:EventImageSh,
                ads:HasEventTypeConceptSh,
                ads:OrganizerSh,
                ads:PerformerSh,
                ads:SubEventSh,
                ads:SuperEventSh .

ads:StartDateSh
    a sh:PropertyShape ;
    sh:path schema:startDate ;
    sh:name "start date" ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:or (
        [ sh:datatype xsd:dateTime ; ]
        [ sh:datatype xsd:date ; ]
    ) ;
    sh:message "schema:startDate is required."@en .

ads:EndDateSh
    a sh:PropertyShape ;
    sh:path schema:endDate ;
    sh:name "end date" ;
    sh:minCount 0 ;
    sh:maxCount 1 ;
    sh:or (
        [ sh:datatype xsd:dateTime ; ]
        [ sh:datatype xsd:date ; ]
    ) .

ads:EventDescriptionSh
    a sh:PropertyShape ;
    sh:path schema:description ;
    sh:name "description" ;
    sh:minCount 0 .

ads:LocationSh
    a sh:PropertyShape ;
    sh:path schema:location ;
    sh:name "location" ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:pattern "^http://kg\\.artsdata\\.ca/resource/" ;
    sh:class schema:Place ;
    sh:message "schema:location is required and must reference an Artsdata-minted (adr:) schema:Place."@en .

ads:EventStatusSh
    a sh:PropertyShape ;
    sh:path schema:eventStatus ;
    sh:name "event status" ;
    sh:maxCount 1 ;
    sh:minCount 0 ;
    sh:in ( schema:EventPostponed
            schema:EventScheduled
            schema:EventCancelled
            schema:EventRescheduled
            schema:EventMovedOnline ) .

ads:EventAttendanceModeSh
    a sh:PropertyShape ;
    sh:path schema:eventAttendanceMode ;
    sh:name "event attendance mode" ;
    sh:maxCount 1 ;
    sh:minCount 0 ;
    sh:in ( schema:OfflineEventAttendanceMode
            schema:OnlineEventAttendanceMode
            schema:MixedEventAttendanceMode ) .

ads:EventImageSh
    a sh:PropertyShape ;
    sh:path schema:image ;
    sh:name "image" ;
    sh:minCount 0 ;
    sh:node ads:EventImageShape .

ads:EventImageShape
    a sh:NodeShape ;
    sh:name "Event Image Shape" ;
    sh:property [
        sh:path rdf:type ;
        sh:name "image type" ;
    ] , [
        sh:path schema:disambiguatingDescription ;
        sh:name "image disambiguating description" ;
        sh:minCount 0 ;
    ] , [
        sh:path schema:url ;
        sh:name "image url" ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:message "Image schema:url is required and must be a valid URL."@en ;
    ] , [
        sh:path schema:usageInfo ;
        sh:name "image usage info" ;
        sh:minCount 0 ;
    ] , [
        sh:path schema:copyrightNotice ;
        sh:name "image copyright notice" ;
        sh:minCount 0 ;
    ] .

ads:HasEventTypeConceptSh
    a sh:PropertyShape ;
    sh:path ado:hasEventTypeConcept ;
    sh:name "has event type" ;
    sh:minCount 0 ;
    sh:nodeKind sh:IRI ;
    sh:pattern "^http://kg\\.artsdata\\.ca/resource/" ;
    sh:class skos:Concept ;
    sh:message "ado:hasEventTypeConcept must reference an Artsdata-minted (adr:) skos:Concept from the Artsdata Event Types controlled vocabulary (see ads:EventTypeConceptShape)."@en .

ads:OrganizerSh
    a sh:PropertyShape ;
    sh:path schema:organizer ;
    sh:name "organizer" ;
    sh:minCount 0 ;
    sh:nodeKind sh:IRI ;
    sh:pattern "^http://kg\\.artsdata\\.ca/resource/" ;
    sh:class schema:Organization ;
    sh:message "schema:organizer must reference an Artsdata-minted (adr:) schema:Organization."@en .

ads:PerformerSh
    a sh:PropertyShape ;
    sh:path schema:performer ;
    sh:name "performer" ;
    sh:minCount 0 ;
    sh:nodeKind sh:IRI ;
    sh:pattern "^http://kg\\.artsdata\\.ca/resource/" ;
    sh:message "schema:performer must reference an Artsdata-minted (adr:) entity."@en .

ads:SubEventSh
    a sh:PropertyShape ;
    sh:path schema:subEvent ;
    sh:name "sub event" ;
    sh:minCount 0 ;
    sh:nodeKind sh:IRI .

ads:SuperEventSh
    a sh:PropertyShape ;
    sh:path schema:superEvent ;
    sh:name "super event" ;
    sh:minCount 0 ;
    sh:nodeKind sh:IRI .


################
# Controlled Vocabulary Value Shape
# Reused wherever ado:hasEventTypeConcept's range is skos:Concept.
#
# Declared as a self-targeting shape (sh:targetObjectsOf) rather than being
# referenced with sh:node from ads:HasEventTypeConceptSh above -- see the
# "Controlled-vocabulary concept checks" note in shacl_artsdata_common.ttl
# for why.
################

ads:EventTypeConceptShape
    a sh:NodeShape ;
    sh:name "Artsdata Event Type Concept" ;
    sh:targetObjectsOf ado:hasEventTypeConcept ;
    sh:nodeKind sh:IRI ;
    sh:class skos:Concept ;
    sh:property ads:PrefLabelSh,
                ads:NoSchemaNameOnConceptSh ;
    sh:property [
        sh:path skos:inScheme ;
        sh:hasValue adr:ArtsdataEventTypes ;
        sh:message "Value must be a skos:Concept in the Artsdata Event Types vocabulary (adr:ArtsdataEventTypes), see ontology/skos-event-types.ttl."@en ;
    ] ;
    sh:property [
        sh:path owl:deprecated ;
        sh:maxCount 0 ;
        sh:severity sh:Warning ;
        sh:message "This event type concept is deprecated; choose a current concept from the Artsdata Event Types vocabulary."@en ;
    ] .

####################################################
# From shacl_artsdata_liveperformancework.ttl
####################################################

####################################################
# ado:LivePerformanceWork
# See shacl_artsdata_common.ttl for the shared shapes referenced below and
# the file-set header. Must be loaded together with that file (and, for the
# controlled-vocabulary check below, ontology/skos-genres.ttl).
#
# Source: artsdata-api/app/services/sparqls/mint/liveperformancework/construct_liveperformancework_transform.sparql
####################################################

ads:LivePerformanceWorkShape
    a sh:NodeShape ;
    sh:name "Live Performance Work Shape" ;
    sh:targetClass ado:LivePerformanceWork ;
    sh:property ads:NameSh,
                ads:UrlSh,
                ads:SameAsSh,
                ads:AlternateNameSh,
                ads:DisambiguatingDescriptionSh,
                ads:LpwDescriptionSh,
                ads:UnstructuredImageSh,
                ads:HasGenreSh,
                ads:UsesExpressionOfSh .

ads:LpwDescriptionSh
    a sh:PropertyShape ;
    sh:path schema:description ;
    sh:name "description" ;
    sh:minCount 0 .

ads:HasGenreSh
    a sh:PropertyShape ;
    sh:path ado:hasGenre ;
    sh:name "has genre" ;
    sh:minCount 0 ;
    sh:nodeKind sh:IRI ;
    sh:pattern "^http://kg\\.artsdata\\.ca/resource/" ;
    sh:class skos:Concept ;
    sh:message "ado:hasGenre must reference an Artsdata-minted (adr:) skos:Concept from the Artsdata Genres controlled vocabulary (see ads:GenreConceptShape)."@en .

ads:UsesExpressionOfSh
    a sh:PropertyShape ;
    sh:path ado:usesExpressionOf ;
    sh:name "uses expression of" ;
    sh:minCount 0 ;
    sh:nodeKind sh:IRI ;
    sh:pattern "^http://kg\\.artsdata\\.ca/resource/" ;
    sh:class schema:CreativeWork ;
    sh:message "ado:usesExpressionOf must reference an Artsdata-minted (adr:) schema:CreativeWork. (Not yet confirmed by a mint SPARQL as of this writing -- re-verify once one exists.)"@en .


################
# Controlled Vocabulary Value Shape
# Reused wherever ado:hasGenre's range is skos:Concept.
#
# Declared as a self-targeting shape (sh:targetObjectsOf) rather than being
# referenced with sh:node from ads:HasGenreSh above -- see the
# "Controlled-vocabulary concept checks" note in shacl_artsdata_common.ttl
# for why.
################

ads:GenreConceptShape
    a sh:NodeShape ;
    sh:name "Artsdata Genre Concept" ;
    sh:targetObjectsOf ado:hasGenre ;
    sh:nodeKind sh:IRI ;
    sh:class skos:Concept ;
    sh:property ads:PrefLabelSh,
                ads:NoSchemaNameOnConceptSh ;
    sh:property [
        sh:path skos:inScheme ;
        sh:hasValue adr:ArtsdataGenres ;
        sh:message "Value must be a skos:Concept in the Artsdata Genres vocabulary (adr:ArtsdataGenres), see ontology/skos-genres.ttl."@en ;
    ] ;
    sh:property [
        sh:path owl:deprecated ;
        sh:maxCount 0 ;
        sh:severity sh:Warning ;
        sh:message "This genre concept is deprecated; choose a current concept from the Artsdata Genres vocabulary."@en ;
    ] .

####################################################
# From shacl_artsdata_organization.ttl
####################################################

####################################################
# schema:Organization
# See shacl_artsdata_common.ttl for the shared shapes referenced below and
# the file-set header. Must be loaded together with that file (and, for the
# controlled-vocabulary check below, ontology/skos-organization-types.ttl).
#
# Source: artsdata-api/app/services/sparqls/mint/organization/construct_organization_transform.sparql
#         artsdata-api/app/services/sparqls/mint/transform/K1-212_map_organization_types.sparql
####################################################

ads:OrganizationShape
    a sh:NodeShape ;
    sh:name "Organization Shape" ;
    sh:targetClass schema:Organization ;
    sh:property ads:NameSh,
                ads:UrlSh,
                ads:SameAsSh,
                ads:AdditionalTypeSh,
                ads:AlternateNameSh,
                ads:DisambiguatingDescriptionSh,
                ads:UnstructuredImageSh,
                ads:LogoSh,
                ads:TelephoneSh,
                ads:CanadianBusinessNumberSh,
                ads:HasOrganizationTypeConceptSh .
    # Not shaped: ado:originEC (see shacl_artsdata_common.ttl header) .

ads:HasOrganizationTypeConceptSh
    a sh:PropertyShape ;
    sh:path ado:hasOrganizationTypeConcept ;
    sh:name "has organization type" ;
    sh:minCount 0 ;
    sh:nodeKind sh:IRI ;
    sh:pattern "^http://kg\\.artsdata\\.ca/resource/" ;
    sh:class skos:Concept ;
    sh:message "ado:hasOrganizationTypeConcept must reference an Artsdata-minted (adr:) skos:Concept from the Artsdata Organization Types controlled vocabulary (see ads:OrganizationTypeConceptShape)."@en .

ads:LogoSh
    a sh:PropertyShape ;
    sh:path schema:logo ;
    sh:name "logo" ;
    sh:minCount 0 .

ads:TelephoneSh
    a sh:PropertyShape ;
    sh:path schema:telephone ;
    sh:name "telephone" ;
    sh:minCount 0 .

ads:CanadianBusinessNumberSh
    a sh:PropertyShape ;
    sh:path wdt:P8860 ;
    sh:name "Canadian Business Number" ;
    sh:minCount 0 ;
    sh:pattern "^\\d{9}$" ;
    sh:message "Canadian Business Number (wdt:P8860) must be 9 digits."@en .


################
# Controlled Vocabulary Value Shape
# Reused wherever ado:hasOrganizationTypeConcept's range is skos:Concept.
#
# Declared as a self-targeting shape (sh:targetObjectsOf) rather than being
# referenced with sh:node from ads:HasOrganizationTypeConceptSh above -- see
# the "Controlled-vocabulary concept checks" note in
# shacl_artsdata_common.ttl for why.
################

ads:OrganizationTypeConceptShape
    a sh:NodeShape ;
    sh:name "Artsdata Organization Type Concept" ;
    sh:targetObjectsOf ado:hasOrganizationTypeConcept ;
    sh:nodeKind sh:IRI ;
    sh:class skos:Concept ;
    sh:property ads:PrefLabelSh,
                ads:NoSchemaNameOnConceptSh ;
    sh:property [
        sh:path skos:inScheme ;
        sh:hasValue adr:ArtsdataOrganizationTypes ;
        sh:message "Value must be a skos:Concept in the Artsdata Organization Types vocabulary (adr:ArtsdataOrganizationTypes), see ontology/skos-organization-types.ttl."@en ;
    ] ;
    sh:property [
        sh:path owl:deprecated ;
        sh:maxCount 0 ;
        sh:severity sh:Warning ;
        sh:message "This organization type concept is deprecated; choose a current concept from the Artsdata Organization Types vocabulary."@en ;
    ] .

####################################################
# From shacl_artsdata_place.ttl
####################################################

####################################################
# schema:Place
# See shacl_artsdata_common.ttl for the shared shapes referenced below and
# the file-set header. Must be loaded together with that file (and, for the
# controlled-vocabulary check below, ontology/skos-place-types.ttl).
#
# Source: artsdata-api/app/services/sparqls/mint/place/construct_place_transform.sparql
#         artsdata-api/app/services/sparqls/mint/transform/K1-210_map_place_types.sparql
####################################################

ads:PlaceShape
    a sh:NodeShape ;
    sh:name "Place Shape" ;
    sh:targetClass schema:Place ;
    sh:property ads:NameSh,
                ads:UrlSh,
                ads:SameAsSh,
                ads:AdditionalTypeSh,
                ads:HasPlaceTypeConceptSh,
                ads:AlternateNameSh,
                ads:DisambiguatingDescriptionSh,
                ads:PlaceDescriptionSh,
                ads:ContainedInPlaceSh,
                ads:UnstructuredImageSh,
                ads:LongitudeSh,
                ads:LatitudeSh,
                ads:ManagedBySh,
                ads:OwnedBySh,
                ads:UsedBySh,
                ads:HasResidentSh,
                ads:AddressSh .

ads:HasPlaceTypeConceptSh
    a sh:PropertyShape ;
    sh:path ado:hasPlaceTypeConcept ;
    sh:name "has place type" ;
    sh:minCount 0 ;
    sh:nodeKind sh:IRI ;
    sh:pattern "^http://kg\\.artsdata\\.ca/resource/" ;
    sh:class skos:Concept ;
    sh:message "ado:hasPlaceTypeConcept must reference an Artsdata-minted (adr:) skos:Concept from the Artsdata Place Types controlled vocabulary (see ads:PlaceTypeConceptShape)."@en .

ads:PlaceDescriptionSh
    a sh:PropertyShape ;
    sh:path schema:description ;
    sh:name "description" ;
    sh:minCount 0 .

ads:ContainedInPlaceSh
    a sh:PropertyShape ;
    sh:path schema:containedInPlace ;
    sh:name "contained in place" ;
    sh:minCount 0 ;
    sh:nodeKind sh:IRI ;
    sh:class schema:Place .

ads:LongitudeSh
    a sh:PropertyShape ;
    sh:path schema:longitude ;
    sh:name "longitude" ;
    sh:minCount 0 .

ads:LatitudeSh
    a sh:PropertyShape ;
    sh:path schema:latitude ;
    sh:name "latitude" ;
    sh:minCount 0 .

ads:ManagedBySh
    a sh:PropertyShape ;
    sh:path ado:managedBy ;
    sh:name "managed by" ;
    sh:minCount 0 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:pattern "^http://kg\\.artsdata\\.ca/resource/" ;
    sh:class schema:Organization ;
    sh:message "ado:managedBy must reference at most one Artsdata-minted (adr:) schema:Organization."@en .

ads:OwnedBySh
    a sh:PropertyShape ;
    sh:path ado:ownedBy ;
    sh:name "owned by" ;
    sh:minCount 0 ;
    sh:nodeKind sh:IRI ;
    sh:pattern "^http://kg\\.artsdata\\.ca/resource/" ;
    sh:class schema:Organization ;
    sh:message "ado:ownedBy must reference an Artsdata-minted (adr:) schema:Organization."@en .

ads:UsedBySh
    a sh:PropertyShape ;
    sh:path ado:usedBy ;
    sh:name "used by" ;
    sh:minCount 0 ;
    sh:nodeKind sh:IRI ;
    sh:pattern "^http://kg\\.artsdata\\.ca/resource/" ;
    sh:class schema:Organization ;
    sh:message "ado:usedBy must reference an Artsdata-minted (adr:) schema:Organization."@en .

ads:HasResidentSh
    a sh:PropertyShape ;
    sh:path ado:hasResident ;
    sh:name "has resident" ;
    sh:minCount 0 ;
    sh:nodeKind sh:IRI ;
    sh:pattern "^http://kg\\.artsdata\\.ca/resource/" ;
    sh:class schema:Organization ;
    sh:message "ado:hasResident must reference an Artsdata-minted (adr:) schema:Organization."@en .

ads:AddressSh
    a sh:PropertyShape ;
    sh:path schema:address ;
    sh:name "address" ;
    sh:minCount 0 ;
    sh:node ads:PostalAddressShape .

# Unlike shacl_artsdata.ttl's ads:PostalAddressShape (external submissions,
# all subfields sh:minCount 1), every subfield here is optional: the mint
# query's OPTIONAL blocks show a CORE-graph address can legitimately be
# partial.
ads:PostalAddressShape
    a sh:NodeShape ;
    sh:name "Postal Address Shape" ;
    sh:property [
        sh:path schema:streetAddress ;
        sh:name "street address" ;
        sh:minCount 1 ;
    ] , [
        sh:path schema:addressLocality ;
        sh:name "address locality" ;
        sh:minCount 1 ;
    ] , [
        sh:path schema:addressRegion ;
        sh:name "address region" ;
        sh:minCount 1 ;
    ] , [
        sh:path schema:postalCode ;
        sh:name "postal code" ;
        sh:minCount 1 ;
    ] , [
        sh:path schema:addressCountry ;
        sh:name "address country" ;
        sh:minCount 1 ;
    ] .


################
# Controlled Vocabulary Value Shape
# Reused wherever ado:hasPlaceTypeConcept's range is skos:Concept.
#
# Declared as a self-targeting shape (sh:targetObjectsOf) rather than being
# referenced with sh:node from ads:HasPlaceTypeConceptSh above -- see the
# "Controlled-vocabulary concept checks" note in shacl_artsdata_common.ttl
# for why.
################

ads:PlaceTypeConceptShape
    a sh:NodeShape ;
    sh:name "Artsdata Place Type Concept" ;
    sh:targetObjectsOf ado:hasPlaceTypeConcept ;
    sh:nodeKind sh:IRI ;
    sh:class skos:Concept ;
    sh:property ads:PrefLabelSh,
                ads:NoSchemaNameOnConceptSh ;
    sh:property [
        sh:path skos:inScheme ;
        sh:hasValue adr:ArtsdataPlaceTypes ;
        sh:message "Value must be a skos:Concept in the Artsdata Place Types vocabulary (adr:ArtsdataPlaceTypes), see ontology/skos-place-types.ttl."@en ;
    ] ;
    sh:property [
        sh:path owl:deprecated ;
        sh:maxCount 0 ;
        sh:severity sh:Warning ;
        sh:message "This place type concept is deprecated; choose a current concept from the Artsdata Place Types vocabulary."@en ;
    ] .

