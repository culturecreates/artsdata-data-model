@prefix ads:    <http://kg.artsdata.ca/shacl/> .
@prefix prov:   <http://www.w3.org/ns/prov#> .
@prefix rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix schema: <http://schema.org/> .
@prefix sh:     <http://www.w3.org/ns/shacl#> .
@prefix skos:   <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .

####################################################
# Entity metadata (prov:Entity)
# See shacl_artsdata_common.ttl for the file-set header. Must be loaded
# together with that file.
#
# Every minted entity has its own metadata resource in the core graph. Its
# URI is the entity URI followed by "_dataset"
# (e.g. adr:K23-10735_dataset) and it points to the entity with schema:about.
# It has no schema:Thing type, so it is targeted by its use of schema:about.
#
# Update activities: the metadata lists each prov:Activity applied to the
# entity with prov:wasInfluencedBy. Those triples and the activities
# themselves (prov:startedAtTime, prov:wasAssociatedWith, rdfs:comment) live
# in the http://kg.artsdata.ca/logs named graph, not in core, so the
# activities are only checked here when the logs graph is loaded in the data
# graph; no class check is made on them for that reason.
####################################################

ads:EntityMetadataShape
    a sh:NodeShape ;
    sh:name "Entity Metadata Shape" ;
    sh:targetSubjectsOf schema:about ;
    sh:property ads:MetadataTypeSh,
                ads:AboutSh,
                ads:MetadataDateModifiedSh,
                ads:MetadataGeneratedAtTimeSh,
                ads:MetadataHistoryNoteSh,
                ads:MetadataWasInfluencedBySh .

ads:MetadataTypeSh
    a sh:PropertyShape ;
    sh:path rdf:type ;
    sh:name "type" ;
    sh:hasValue prov:Entity ;
    sh:message "Entity metadata must be a prov:Entity."@en .

ads:AboutSh
    a sh:PropertyShape ;
    sh:path schema:about ;
    sh:name "about" ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:pattern "^http://kg\\.artsdata\\.ca/resource/" ;
    sh:message "schema:about is required exactly once and must reference an Artsdata-minted (adr:) entity."@en .

ads:MetadataDateModifiedSh
    a sh:PropertyShape ;
    sh:path schema:dateModified ;
    sh:name "date modified" ;
    sh:minCount 0 ;
    sh:maxCount 1 ;
    sh:datatype xsd:dateTime ;
    sh:message "schema:dateModified must be a single xsd:dateTime."@en .

ads:MetadataGeneratedAtTimeSh
    a sh:PropertyShape ;
    sh:path prov:generatedAtTime ;
    sh:name "generated at time" ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:datatype xsd:dateTime ;
    sh:severity sh:Warning ;
    sh:message "prov:generatedAtTime should be present exactly once as an xsd:dateTime."@en .

ads:MetadataHistoryNoteSh
    a sh:PropertyShape ;
    sh:path skos:historyNote ;
    sh:name "history note" ;
    sh:minCount 0 .

ads:MetadataWasInfluencedBySh
    a sh:PropertyShape ;
    sh:path prov:wasInfluencedBy ;
    sh:name "was influenced by" ;
    sh:minCount 0 ;
    sh:nodeKind sh:IRI ;
    sh:message "prov:wasInfluencedBy must reference a prov:Activity IRI."@en .
