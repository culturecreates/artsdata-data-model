@prefix ado:    <http://kg.artsdata.ca/ontology/> .
@prefix adr:    <http://kg.artsdata.ca/resource/> .
@prefix ext:    <http://example-provider.com/> .
@prefix schema: <http://schema.org/> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .

# Fixture for shacl/shacl_artsdata_ontology.ttl (see shacl/tests/test_shacl_ontology.py).
# Must be loaded together with the real vocabulary files under
# ontology/skos-*.ttl so that adr:K6-200, adr:Arena, adr:TheatrePerformance,
# adr:AcappellaMusicPerformance, adr:Amphitheatre and adr:ArtMuseum resolve
# to real skos:Concept instances (adr:AcappellaMusicPerformance is
# deprecated, used to exercise the Warning-severity check).

# --- Valid LivePerformanceWork ---
ext:show1 a ado:LivePerformanceWork ;
    schema:name "The Rite of Spring" ;
    ado:hasGenre adr:K6-200 ;
    ado:usesExpressionOf ext:musicalWork1 .

ext:musicalWork1 a schema:CreativeWork ;
    schema:name "Le Sacre du printemps" .

# --- Invalid LivePerformanceWork: genre from wrong vocabulary (a place type, not a genre) ---
ext:show2 a ado:LivePerformanceWork ;
    schema:name "Bad Show" ;
    ado:hasGenre adr:Arena .

# --- Valid Event ---
ext:event1 a schema:Event ;
    schema:name "Opening Night" ;
    schema:startDate "2026-10-01T20:00:00"^^xsd:dateTime ;
    schema:location ext:venue1 ;
    ado:hasEventTypeConcept adr:TheatrePerformance .

# --- Event using a deprecated event type concept (Warning expected, not a Violation) ---
ext:event2 a schema:Event ;
    schema:name "Old Style Show" ;
    schema:startDate "2026-11-01T20:00:00"^^xsd:dateTime ;
    schema:location ext:venue1 ;
    ado:hasEventTypeConcept adr:AcappellaMusicPerformance .

# --- Valid Place with ontology extensions ---
ext:venue1 a schema:Place ;
    schema:name "The Grand Hall" ;
    ado:hasPlaceTypeConcept adr:Amphitheatre ;
    ado:managedBy ext:org1 ;
    ado:ownedBy ext:org1 .

ext:org1 a schema:Organization ;
    schema:name "Grand Hall Society" .

# --- Invalid Place: managedBy has two organizations (maxCount 1 violation) ---
ext:venue2 a schema:Place ;
    schema:name "Second Venue" ;
    ado:managedBy ext:org1, ext:org2 .

ext:org2 a schema:Organization ;
    schema:name "Other Org" .

# --- Invalid Place: managedBy points to a Person, not an Organization ---
ext:venue3 a schema:Place ;
    schema:name "Third Venue" ;
    ado:managedBy ext:person1 .

ext:person1 a schema:Person ;
    schema:name "Jane Doe" .

# --- Valid Organization with an organization type from the correct vocabulary ---
ext:org3 a schema:Organization ;
    schema:name "City Art Museum" ;
    ado:hasOrganizationTypeConcept adr:ArtMuseum .

# --- Invalid Organization: organization type from wrong vocabulary (a place type, not an organization type) ---
ext:org4 a schema:Organization ;
    schema:name "Bad Org" ;
    ado:hasOrganizationTypeConcept adr:Arena .
